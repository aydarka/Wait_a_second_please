{
  "mcpServers": {
    "UnityMCP": {
      "type": "stdio",
      "command": "mcp-for-unity",
      "args": [
        "--transport",
        "stdio",
        "--default-instance",
        "Wait_a_second_please"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--open-web-dashboard",
        "False",
        "--enable-gui-log-window",
        "False"
      ]
    }
  }
}
